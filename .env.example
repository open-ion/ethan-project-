# AI summarization settings.
# Set OPENAI_API_KEY (or AI_API_KEY) in GitHub Actions secrets or your local shell to enable real AI summaries.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_SUMMARY_LIMIT=20
OPENAI_API_KEY=

# 無料/OpenAI互換プロバイダを使う場合は AI_BASE_URL + AI_API_KEY + AI_MODEL を差し替える。
# 例:
#   Groq(無料枠):        AI_BASE_URL=https://api.groq.com/openai/v1        AI_MODEL=llama-3.3-70b-versatile
#   Gemini(無料枠):      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
#   OpenRouter(無料枠):  AI_BASE_URL=https://openrouter.ai/api/v1          AI_MODEL=deepseek/deepseek-chat-v3:free
#   Cerebras(無料枠):    AI_BASE_URL=https://api.cerebras.ai/v1            AI_MODEL=llama-3.3-70b
#   Mistral(無料枠):     AI_BASE_URL=https://api.mistral.ai/v1             AI_MODEL=mistral-small-latest
AI_BASE_URL=
AI_API_KEY=

# RSS fetch settings.
RSS_FETCH_LIMIT_PER_SOURCE=8
RSS_FETCH_RETRIES=2
RSS_FETCH_TIMEOUT_MS=12000

# Orchestration OS — claude-code runtime (Anthropic Messages API).
# Enable with the flag, then provide an API key to actually call the model.
# Without these, the orchestrator falls back to the deterministic `plan` runtime.
AGATHON_CLAUDE_CODE=
ANTHROPIC_API_KEY=
# Optional overrides:
ANTHROPIC_BASE_URL=https://api.anthropic.com
AGATHON_CLAUDE_MODEL=claude-opus-4-8
AGATHON_MAX_TOKENS=1024
AGATHON_TIMEOUT_MS=60000
